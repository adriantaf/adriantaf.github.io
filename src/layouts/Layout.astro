---
import "./styles/Fonts.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Adrian Tafoya — desarrollador de software. Portafolio inspirado en VS Code con tema Monokai Modern Contrast."
		/>
		<meta name="theme-color" content="#1A1B17" />
		<title>Adrian Tafoya — portfolio</title>
	</head>
	<body class="font-mono text-mk-fg bg-mk-chrome antialiased">
		<slot />
	</body>
</html>

<style is:global>
	* {
		scroll-behavior: smooth;
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		height: 100%;
		overflow: hidden;
	}

	::selection {
		background: #49483e;
		color: #f8f8f2;
	}

	.syn-kw {
		color: #f92672;
	}
	.syn-str {
		color: #e6db74;
	}
	.syn-fn {
		color: #a6e22e;
	}
	.syn-type {
		color: #66d9ef;
		font-style: italic;
	}
	.syn-num {
		color: #ae81ff;
	}
	.syn-param {
		color: #fd971f;
		font-style: italic;
	}
	.syn-cmt {
		color: #75715e;
	}
	.syn-fg {
		color: #f8f8f2;
	}

	.ide-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: inherit;
		font-size: 12px;
		padding: 0.35rem 0.75rem;
		border: none;
		cursor: pointer;
		text-decoration: none;
		transition: filter 0.15s ease, background-color 0.15s ease;
	}
	.ide-btn-primary {
		background: #f92672;
		color: #f8f8f2;
	}
	.ide-btn-primary:hover {
		filter: brightness(1.1);
	}
	.ide-btn-secondary {
		background: #75715e;
		color: #f8f8f2;
	}
	.ide-btn-secondary:hover {
		filter: brightness(1.15);
	}
	.ide-btn-ghost {
		background: transparent;
		color: #66d9ef;
		border: 1px solid #2a2b24;
	}
	.ide-btn-ghost:hover {
		background: #3e3d32;
	}

	.cursor-caret {
		display: inline-block;
		width: 8px;
		height: 1.1em;
		margin-left: 2px;
		vertical-align: text-bottom;
		background: #f8f8f2;
		animation: cursorBlink 1.1s step-end infinite;
	}

	@keyframes cursorBlink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor-caret {
			animation: none;
			opacity: 1;
		}
		* {
			scroll-behavior: auto;
		}
	}
</style>
