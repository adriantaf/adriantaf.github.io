---
import "./styles/Fonts.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Adrian Tafoya — desarrollador de software. Diseño e implemento productos web y desktop con interfaces claras y detalle de producto."
		/>
		<meta name="theme-color" content="#f5f5f7" />
		<title>Adrian Tafoya | Portafolio</title>
	</head>
	<body class="font-sans text-ink bg-canvas antialiased">
		<div class="page-bg" aria-hidden="true"></div>
		<div class="relative z-10 min-h-dvh">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	* {
		scroll-behavior: smooth;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body {
		overflow-x: hidden;
	}

	.page-bg {
		pointer-events: none;
		position: fixed;
		inset: 0;
		z-index: 0;
		background:
			radial-gradient(ellipse 80% 50% at 50% -20%, rgba(0, 113, 227, 0.08), transparent 55%),
			radial-gradient(ellipse 60% 40% at 100% 50%, rgba(0, 0, 0, 0.03), transparent 50%),
			linear-gradient(180deg, #fbfbfd 0%, #f5f5f7 40%, #eef0f3 100%);
	}

	.reveal {
		opacity: 0;
		transform: translateY(16px);
		filter: blur(4px);
		transition:
			opacity 0.7s ease,
			transform 0.7s ease,
			filter 0.7s ease;
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
		filter: blur(0);
	}

	::selection {
		background: rgba(0, 113, 227, 0.18);
	}
</style>

<script>
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add("is-visible");
					observer.unobserve(entry.target);
				}
			});
		},
		{ rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
	);

	document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
</script>
