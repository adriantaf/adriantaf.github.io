---
import Header from "./Header.astro";
import Section from "./shared/Section.astro";
import { projects, stack } from "../data/projects";
import imgSafeBox from "../assets/img/screenshot-sb.png";
import imgSpotify from "../assets/img/screenshot-sp.png";
import imgHashi from "../assets/img/screenshot-hr.png";
import imgLocOs from "../assets/img/screenshot-lpl.png";

const images: Record<string, ImageMetadata> = {
	"screenshot-sb.png": imgSafeBox,
	"screenshot-sp.png": imgSpotify,
	"screenshot-hr.png": imgHashi,
	"screenshot-lpl.png": imgLocOs,
};
---

<Header />

<main>
	<section
		id="hero"
		class="relative mx-auto flex min-h-[calc(100dvh-3.25rem)] w-full max-w-content flex-col justify-center px-5 py-16 md:px-6 md:py-24"
	>
		<div class="max-w-3xl animate-fade-up">
			<p class="mb-5 text-[15px] font-medium tracking-wide text-ink-muted">
				Desarrollador de software
			</p>
			<h1 class="text-[48px] font-semibold leading-[1.05] tracking-tight text-ink md:text-[72px]">
				Adrian Tafoya
			</h1>
			<p class="mt-5 max-w-xl text-[21px] font-medium leading-snug tracking-tight text-ink md:text-[28px]">
				Software y productos web con foco en claridad y detalle.
			</p>
			<p class="mt-4 max-w-lg text-[17px] leading-relaxed text-ink-muted md:text-[19px]">
				Diseño e implemento productos web y desktop con interfaces claras y detalle de producto.
			</p>
			<div class="mt-9 flex flex-wrap items-center gap-3">
				<a
					href="#work"
					class="inline-flex items-center justify-center rounded-full bg-accent px-5 py-2.5 text-[15px] font-medium text-white transition-colors hover:bg-accent-hover"
				>
					Ver trabajo
				</a>
				<a
					href="mailto:atafoya863@gmail.com"
					class="inline-flex items-center justify-center rounded-full px-5 py-2.5 text-[15px] font-medium text-accent transition-colors hover:bg-accent/10"
				>
					Escribirme
				</a>
			</div>
		</div>
	</section>

	<Section
		id="work"
		title="Selected Work"
		subtitle="Cuatro piezas que mejor representan cómo pienso el producto: utilidad, interfaz y entrega."
	>
		<div class="flex flex-col gap-20 md:gap-28">
			{
				projects.map((project, index) => {
					const img = images[project.image];
					const reverse = index % 2 === 1;
					return (
						<article class:list={["reveal grid items-center gap-8 md:grid-cols-2 md:gap-14", reverse && "md:[&>div:first-child]:order-2"]}>
							<div class="group overflow-hidden rounded-2xl bg-canvas-elevated shadow-[0_2px_24px_rgba(0,0,0,0.06)] ring-1 ring-black/[0.04]">
								<img
									src={img.src}
									alt={project.imageAlt}
									width={img.width}
									height={img.height}
									loading={index === 0 ? "eager" : "lazy"}
									class="h-auto w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
								/>
							</div>
							<div>
								<div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] text-ink-muted">
									<span class="font-medium text-accent">{project.tag}</span>
									<span aria-hidden="true">·</span>
									<span>{project.date}</span>
								</div>
								<h3 class="text-[28px] font-semibold tracking-tight text-ink md:text-[32px]">
									{project.name}
								</h3>
								<p class="mt-3 text-[17px] leading-relaxed text-ink-muted">
									{project.description}
								</p>
								<ul class="mt-5 flex flex-wrap gap-2">
									{project.tech.map((tech) => (
										<li class="rounded-md bg-black/[0.04] px-2.5 py-1 font-mono text-[12px] text-ink-muted">
											{tech}
										</li>
									))}
								</ul>
								<div class="mt-7 flex flex-wrap gap-3">
									{project.links.map((link) =>
										link.primary ? (
											<a
												href={link.href}
												target="_blank"
												rel="noopener noreferrer"
												class="inline-flex items-center rounded-full bg-accent px-4 py-2 text-[14px] font-medium text-white transition-colors hover:bg-accent-hover"
											>
												{link.label}
											</a>
										) : (
											<a
												href={link.href}
												target="_blank"
												rel="noopener noreferrer"
												class="inline-flex items-center rounded-full px-4 py-2 text-[14px] font-medium text-accent transition-colors hover:bg-accent/10"
											>
												{link.label}
											</a>
										),
									)}
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</Section>

	<Section
		id="about"
		title="Sobre mí"
		subtitle="De Ensenada, con base en sistemas y un gusto por el detalle de interfaz."
	>
		<div class="reveal max-w-2xl space-y-5 text-[17px] leading-relaxed text-ink-muted md:text-[19px]">
			<p>
				Estudié Ingeniería en Sistemas en el Instituto Tecnológico de Ensenada y Técnico en
				Programación en el CBTIS 41. Desde 2020 combino formación formal con aprendizaje
				autodidacta.
			</p>
			<p>
				Empecé en front-end y hoy me muevo hacia productos full-stack y desktop: me interesa
				construir herramientas útiles, con interfaces claras y un nivel de pulido que se note
				en el uso diario.
			</p>
			<p>
				Ahora busco proyectos donde el diseño y el código se encuentren — sitios de negocio,
				apps locales y experiencias web que se sientan simples de usar.
			</p>
		</div>
	</Section>

	<Section
		id="stack"
		title="Stack"
		subtitle="Herramientas con las que construyo hoy."
		className="pb-8 md:pb-12"
	>
		<ul class="reveal flex flex-wrap gap-2.5 md:gap-3">
			{
				stack.map((item) => (
					<li class="rounded-full border border-black/[0.08] bg-canvas-elevated px-4 py-2 text-[14px] font-medium text-ink md:text-[15px]">
						{item}
					</li>
				))
			}
		</ul>
	</Section>

	<section id="contact" class="mx-auto w-full max-w-content px-5 pb-24 pt-8 md:px-6 md:pb-32">
		<div
			class="reveal rounded-[28px] bg-ink px-8 py-14 text-center text-white md:px-16 md:py-20"
		>
			<h2 class="text-[32px] font-semibold tracking-tight md:text-[44px]">
				¿Construimos algo?
			</h2>
			<p class="mx-auto mt-4 max-w-md text-[17px] leading-relaxed text-white/65 md:text-[19px]">
				Cuéntame sobre tu idea o proyecto. Respondo por email.
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a
					href="mailto:atafoya863@gmail.com"
					class="inline-flex rounded-full bg-white px-5 py-2.5 text-[15px] font-medium text-ink transition-opacity hover:opacity-90"
				>
					atafoya863@gmail.com
				</a>
				<a
					href="https://www.linkedin.com/in/adriantaf/"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex rounded-full px-5 py-2.5 text-[15px] font-medium text-white/80 transition-colors hover:text-white"
				>
					LinkedIn
				</a>
				<a
					href="https://github.com/adriantaf"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex rounded-full px-5 py-2.5 text-[15px] font-medium text-white/80 transition-colors hover:text-white"
				>
					GitHub
				</a>
			</div>
		</div>
	</section>
</main>

<footer class="border-t border-black/[0.06] py-8">
	<div
		class="mx-auto flex max-w-content flex-col items-start justify-between gap-2 px-5 text-[13px] text-ink-muted md:flex-row md:items-center md:px-6"
	>
		<span>© {new Date().getFullYear()} Adrian Tafoya</span>
		<span>Hecho con Astro</span>
	</div>
</footer>
