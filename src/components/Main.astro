---
import Section from "./shared/Section.astro";
import { projects, stack } from "../data/projects";
import imgSafeBox from "../assets/img/screenshot-sb.png";
import imgSpotify from "../assets/img/screenshot-sp.png";
import imgHashi from "../assets/img/screenshot-hr.png";
import imgLocOs from "../assets/img/screenshot-lpl.png";

const images: Record<string, ImageMetadata> = {
	"screenshot-sb.png": imgSafeBox,
	"screenshot-sp.png": imgSpotify,
	"screenshot-hr.png": imgHashi,
	"screenshot-lpl.png": imgLocOs,
};
---

<div class="mx-auto w-full max-w-4xl pb-8">
	<section id="hero" class="border-b border-mk-border px-4 py-12 md:px-8 md:py-16">
		<div class="mb-6 flex items-center gap-2 text-[12px] text-mk-comment">
			<span class="text-mk-param">portfolio</span>
			<span>&gt;</span>
			<span class="text-mk-fg">welcome.ts</span>
		</div>

		<pre
			class="overflow-x-auto text-[13px] leading-7 md:text-[14px] md:leading-8"
			aria-label="Presentación"
		><code><span class="syn-cmt">// Monokai Modern Contrast · portfolio</span>
<span class="syn-kw">const</span> <span class="syn-fg">developer</span> <span class="syn-fg">=</span> <span class="syn-fg">{"{"}</span>
  <span class="syn-fg">name:</span> <span class="syn-str">"Adrian Tafoya"</span><span class="syn-fg">,</span>
  <span class="syn-fg">role:</span> <span class="syn-str">"Software developer"</span><span class="syn-fg">,</span>
  <span class="syn-fg">focus:</span> <span class="syn-fg">[</span><span class="syn-str">"web"</span><span class="syn-fg">,</span> <span class="syn-str">"desktop"</span><span class="syn-fg">],</span>
<span class="syn-fg">{"}"};</span>

<span class="syn-cmt">/** Diseño e implemento productos web y desktop</span>
<span class="syn-cmt"> *  con interfaces claras y detalle de producto.</span>
<span class="syn-cmt"> */</span>
<span class="syn-kw">export</span> <span class="syn-kw">function</span> <span class="syn-fn">run</span><span class="syn-fg">()</span> <span class="syn-fg">{"{"}</span>
  <span class="syn-kw">return</span> <span class="syn-str">"open projects"</span><span class="syn-fg">;</span>
<span class="syn-fg">{"}"}</span><span class="cursor-caret" aria-hidden="true"></span></code></pre>

		<div class="mt-8 flex flex-wrap gap-2">
			<a href="#work" class="ide-btn ide-btn-primary">Run projects</a>
			<a href="mailto:atafoya863@gmail.com" class="ide-btn ide-btn-secondary">Open mail</a>
		</div>
	</section>

	<Section id="work" fileName="projects/">
		<h2 class="mb-2 text-[18px] font-semibold text-mk-fg md:text-[20px]">
			<span class="syn-kw">export</span> <span class="syn-kw">const</span>
			<span class="syn-fn"> projects</span>
		</h2>
		<p class="mb-8 max-w-2xl text-[13px] leading-relaxed text-mk-comment md:text-[14px]">
			Cuatro piezas que mejor representan cómo pienso el producto: utilidad, interfaz y entrega.
		</p>
	</Section>

	{
		projects.map((project, index) => {
			const img = images[project.image];
			const reverse = index % 2 === 1;
			return (
				<section
					id={project.id}
					class="border-b border-mk-border px-4 py-10 md:px-8 md:py-12"
				>
					<div class="mb-5 flex items-center gap-2 text-[12px] text-mk-comment">
						<span class="text-mk-param">portfolio</span>
						<span>&gt;</span>
						<span class="text-mk-comment">projects</span>
						<span>&gt;</span>
						<span class="text-mk-fg">{project.fileName}</span>
					</div>
					<article
						class:list={[
							"grid items-start gap-6 md:grid-cols-2 md:gap-8",
							reverse && "md:[&>div:first-child]:order-2",
						]}
					>
						<div class="overflow-hidden border border-mk-border bg-mk-chrome">
							<img
								src={img.src}
								alt={project.imageAlt}
								width={img.width}
								height={img.height}
								loading={index === 0 ? "eager" : "lazy"}
								class="h-auto w-full object-cover"
							/>
						</div>
						<div>
							<div class="mb-3 flex flex-wrap items-center gap-2 text-[12px]">
								<span class="bg-mk-line px-2 py-0.5 text-mk-type">{project.tag}</span>
								<span class="text-mk-number">{project.date}</span>
							</div>
							<h3 class="text-[18px] font-semibold text-mk-fn md:text-[22px]">
								{project.name}
							</h3>
							<p class="mt-3 text-[13px] leading-relaxed text-mk-fg/85 md:text-[14px]">
								{project.description}
							</p>
							<ul class="mt-4 flex flex-wrap gap-1.5">
								{project.tech.map((tech) => (
									<li class="border border-mk-border bg-mk-chrome px-2 py-0.5 text-[11px] text-mk-type">
										{tech}
									</li>
								))}
							</ul>
							<div class="mt-5 flex flex-wrap gap-2">
								{project.links.map((link) =>
									link.primary ? (
										<a
											href={link.href}
											target="_blank"
											rel="noopener noreferrer"
											class="ide-btn ide-btn-primary"
										>
											{link.label}
										</a>
									) : (
										<a
											href={link.href}
											target="_blank"
											rel="noopener noreferrer"
											class="ide-btn ide-btn-ghost"
										>
											{link.label}
										</a>
									),
								)}
							</div>
						</div>
					</article>
				</section>
			);
		})
	}

	<Section id="about" fileName="about.md">
		<h2 class="mb-4 text-[18px] font-semibold text-mk-fg md:text-[20px]">
			<span class="syn-fn">#</span> Sobre mí
		</h2>
		<div class="max-w-2xl space-y-4 text-[13px] leading-relaxed text-mk-fg/85 md:text-[14px]">
			<p>
				Estudié Ingeniería en Sistemas en el Instituto Tecnológico de Ensenada y Técnico en
				Programación en el CBTIS 41. Desde 2020 combino formación formal con aprendizaje
				autodidacta.
			</p>
			<p>
				Empecé en front-end y hoy me muevo hacia productos full-stack y desktop: me interesa
				construir herramientas útiles, con interfaces claras y un nivel de pulido que se note
				en el uso diario.
			</p>
			<p>
				Ahora busco proyectos donde el diseño y el código se encuentren — sitios de negocio,
				apps locales y experiencias web que se sientan simples de usar.
			</p>
		</div>
	</Section>

	<Section id="stack" fileName="stack.json">
		<h2 class="mb-4 text-[18px] font-semibold text-mk-fg md:text-[20px]">
			<span class="syn-fg">{"{"}</span> <span class="syn-str">"stack"</span>
			<span class="syn-fg">:</span> <span class="syn-fg">[</span>
		</h2>
		<ul class="flex flex-wrap gap-2">
			{
				stack.map((item) => (
					<li class="border border-mk-border bg-mk-chrome px-3 py-1.5 text-[12px] text-mk-string">
						"{item}"
					</li>
				))
			}
		</ul>
		<p class="mt-3 text-mk-fg"><span class="syn-fg">]</span> <span class="syn-fg">{"}"}</span></p>
	</Section>

	<Section id="contact" fileName="contact.ts" className="border-b-0">
		<pre class="mb-6 overflow-x-auto text-[13px] leading-7 md:text-[14px]"><code><span class="syn-kw">export</span> <span class="syn-kw">async</span> <span class="syn-kw">function</span> <span class="syn-fn">contact</span><span class="syn-fg">(</span><span class="syn-param">message</span><span class="syn-fg">:</span> <span class="syn-type">string</span><span class="syn-fg">)</span> <span class="syn-fg">{"{"}</span>
  <span class="syn-cmt">// Cuéntame sobre tu idea o proyecto</span>
  <span class="syn-kw">return</span> <span class="syn-fn">send</span><span class="syn-fg">(</span><span class="syn-str">"atafoya863@gmail.com"</span><span class="syn-fg">,</span> <span class="syn-param">message</span><span class="syn-fg">);</span>
<span class="syn-fg">{"}"}</span></code></pre>
		<div class="flex flex-wrap gap-2">
			<a href="mailto:atafoya863@gmail.com" class="ide-btn ide-btn-primary">Email</a>
			<a
				href="https://www.linkedin.com/in/adriantaf/"
				target="_blank"
				rel="noopener noreferrer"
				class="ide-btn ide-btn-ghost"
			>
				LinkedIn
			</a>
			<a
				href="https://github.com/adriantaf"
				target="_blank"
				rel="noopener noreferrer"
				class="ide-btn ide-btn-ghost"
			>
				GitHub
			</a>
			<a
				href="https://marketplace.visualstudio.com/items?itemName=AdrianTafoya.monokai-modern-contrast"
				target="_blank"
				rel="noopener noreferrer"
				class="ide-btn ide-btn-secondary"
			>
				Mi tema VS Code
			</a>
		</div>
	</Section>
</div>
