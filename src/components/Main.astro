---
import Header from "./Header.astro";
import Section from "./shared/Section.astro";
import { projects, stack } from "../data/projects";
import imgSafeBox from "../assets/img/screenshot-sb.png";
import imgSpotify from "../assets/img/screenshot-sp.png";
import imgHashi from "../assets/img/screenshot-hr.png";
import imgLocOs from "../assets/img/screenshot-lpl.png";

const images: Record<string, ImageMetadata> = {
	"screenshot-sb.png": imgSafeBox,
	"screenshot-sp.png": imgSpotify,
	"screenshot-hr.png": imgHashi,
	"screenshot-lpl.png": imgLocOs,
};

function stageLabel(n: number) {
	return `STAGE ${String(n).padStart(2, "0")}`;
}
---

<Header />

<main>
	<section
		id="hero"
		class="relative mx-auto flex min-h-[calc(100dvh-3.5rem)] w-full max-w-content flex-col justify-center px-4 py-16 md:px-6 md:py-24"
	>
		<p
			class="pointer-events-none absolute right-4 top-6 font-pixel text-[8px] text-amber md:right-6 md:top-10 md:text-[9px]"
			aria-hidden="true"
		>
			HI-SCORE 2025
		</p>

		<div class="max-w-3xl animate-fade-up">
			<p class="mb-5 font-pixel text-[10px] text-cyan md:text-[11px]">
				PLAYER 1
			</p>
			<h1 class="font-pixel text-[22px] leading-[1.45] text-ink md:text-[36px] md:leading-[1.4]">
				ADRIAN<br class="md:hidden" /> TAFOYA
			</h1>
			<p class="mt-6 font-pixel text-[9px] leading-relaxed text-amber md:text-[11px]">
				SOFTWARE · WEB · DESKTOP
			</p>
			<p class="mt-5 max-w-lg text-[15px] leading-relaxed text-ink-muted md:text-[17px]">
				Diseño e implemento productos web y desktop con interfaces claras y detalle de producto.
			</p>
			<div class="mt-10 flex flex-wrap items-center gap-3">
				<a href="#work" class="arcade-btn arcade-btn-primary">
					[ PRESS START ]
				</a>
				<a href="mailto:atafoya863@gmail.com" class="arcade-btn arcade-btn-secondary">
					[ INSERT COIN ]
				</a>
			</div>
			<p class="arcade-blink mt-8 font-pixel text-[8px] text-ink-muted md:text-[9px]">
				INSERT COIN TO PLAY<span class="text-cyan">_</span>
			</p>
		</div>
	</section>

	<Section
		id="work"
		title="STAGE SELECT"
		subtitle="Cuatro piezas que mejor representan cómo pienso el producto: utilidad, interfaz y entrega."
	>
		<div class="flex flex-col gap-16 md:gap-24">
			{
				projects.map((project, index) => {
					const img = images[project.image];
					const reverse = index % 2 === 1;
					return (
						<article
							class:list={[
								"reveal grid items-start gap-6 md:grid-cols-2 md:gap-12",
								reverse && "md:[&>div:first-child]:order-2",
							]}
						>
							<div class="group relative border-2 border-cyan bg-crt-panel p-1 shadow-[4px_4px_0_rgba(0,229,255,0.25)]">
								<span class="absolute -top-3 left-3 z-10 bg-crt px-2 font-pixel text-[8px] text-amber">
									{stageLabel(project.stage)}
								</span>
								<img
									src={img.src}
									alt={project.imageAlt}
									width={img.width}
									height={img.height}
									loading={index === 0 ? "eager" : "lazy"}
									class="h-auto w-full object-cover"
								/>
							</div>
							<div>
								<div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px] text-ink-muted">
									<span class="border border-cyan/40 bg-cyan-dim px-2 py-0.5 font-pixel text-[8px] text-cyan">
										{project.tag.toUpperCase()}
									</span>
									<span>{project.date}</span>
								</div>
								<h3 class="font-pixel text-[13px] leading-relaxed text-ink md:text-[16px]">
									{project.name}
								</h3>
								<p class="mt-4 text-[15px] leading-relaxed text-ink-muted md:text-[16px]">
									{project.description}
								</p>
								<ul class="mt-5 flex flex-wrap gap-2">
									{project.tech.map((tech) => (
										<li class="border border-crt-bezel bg-crt-panel px-2 py-1 font-mono text-[12px] text-ink-muted">
											{tech}
										</li>
									))}
								</ul>
								<div class="mt-7 flex flex-wrap gap-3">
									{project.links.map((link) =>
										link.primary ? (
											<a
												href={link.href}
												target="_blank"
												rel="noopener noreferrer"
												class="arcade-btn arcade-btn-primary !text-[8px]"
											>
												[ {link.label} ]
											</a>
										) : (
											<a
												href={link.href}
												target="_blank"
												rel="noopener noreferrer"
												class="arcade-btn arcade-btn-secondary !text-[8px]"
											>
												[ {link.label} ]
											</a>
										),
									)}
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</Section>

	<Section
		id="about"
		title="PLAYER PROFILE"
		subtitle="De Ensenada, con base en sistemas y un gusto por el detalle de interfaz."
	>
		<div class="reveal max-w-2xl space-y-5 border-2 border-crt-bezel bg-crt-panel p-5 text-[15px] leading-relaxed text-ink-muted md:p-8 md:text-[16px]">
			<p>
				Estudié Ingeniería en Sistemas en el Instituto Tecnológico de Ensenada y Técnico en
				Programación en el CBTIS 41. Desde 2020 combino formación formal con aprendizaje
				autodidacta.
			</p>
			<p>
				Empecé en front-end y hoy me muevo hacia productos full-stack y desktop: me interesa
				construir herramientas útiles, con interfaces claras y un nivel de pulido que se note
				en el uso diario.
			</p>
			<p>
				Ahora busco proyectos donde el diseño y el código se encuentren — sitios de negocio,
				apps locales y experiencias web que se sientan simples de usar.
			</p>
		</div>
	</Section>

	<Section
		id="stack"
		title="POWER-UPS"
		subtitle="Herramientas con las que construyo hoy."
		className="pb-8 md:pb-12"
	>
		<ul class="reveal flex flex-wrap gap-2.5 md:gap-3">
			{
				stack.map((item) => (
					<li class="border-2 border-cyan/30 bg-cyan-dim px-3 py-2 font-pixel text-[8px] text-cyan md:text-[9px]">
						{item.toUpperCase()}
					</li>
				))
			}
		</ul>
	</Section>

	<section id="contact" class="mx-auto w-full max-w-content px-4 pb-20 pt-8 md:px-6 md:pb-28">
		<div
			class="reveal border-2 border-amber bg-crt-panel px-6 py-12 text-center shadow-[6px_6px_0_rgba(255,191,0,0.35)] md:px-14 md:py-16"
		>
			<h2 class="font-pixel text-[16px] leading-relaxed text-amber md:text-[22px]">
				CONTINUE?
			</h2>
			<p class="mx-auto mt-5 max-w-md text-[15px] leading-relaxed text-ink-muted md:text-[16px]">
				Cuéntame sobre tu idea o proyecto. Respondo por email.
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a
					href="mailto:atafoya863@gmail.com"
					class="arcade-btn arcade-btn-primary !text-[8px]"
				>
					[ EMAIL ]
				</a>
				<a
					href="https://www.linkedin.com/in/adriantaf/"
					target="_blank"
					rel="noopener noreferrer"
					class="arcade-btn arcade-btn-secondary !text-[8px]"
				>
					[ LINKEDIN ]
				</a>
				<a
					href="https://github.com/adriantaf"
					target="_blank"
					rel="noopener noreferrer"
					class="arcade-btn arcade-btn-secondary !text-[8px]"
				>
					[ GITHUB ]
				</a>
			</div>
		</div>
	</section>
</main>

<footer class="border-t-2 border-crt-bezel py-8">
	<div
		class="mx-auto flex max-w-content flex-col items-start justify-between gap-3 px-4 font-pixel text-[8px] leading-relaxed text-ink-muted md:flex-row md:items-center md:px-6"
	>
		<span>© {new Date().getFullYear()} · HIGH SCORE: ADRIAN</span>
		<span class="text-cyan">ASTRO + VANILLA JS</span>
	</div>
</footer>

<style>
	.arcade-blink {
		animation: blink 1.2s steps(2, start) infinite;
	}

	@keyframes blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.arcade-blink {
			animation: none;
			opacity: 1;
		}
	}
</style>
