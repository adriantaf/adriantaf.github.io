---
const icons = [
	{ id: "explorer", label: "Explorer", active: true, path: "M2 2h5l1 2h6v10H2V2zm1.5 3.5V13h9V5.5h-9z" },
	{ id: "search", label: "Search", active: false, path: "M10.5 9.5a4 4 0 1 0-1.1 2.7l3.2 3.2.9-.9-3.2-3.2a4 4 0 0 0 .2-1.8zM6.5 10a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" },
	{ id: "git", label: "Source Control", active: false, path: "M8 1.5a1.5 1.5 0 0 0-.75 2.8V7H5.5A2.5 2.5 0 1 0 5.5 12H7.25v1.7a1.5 1.5 0 1 0 1.5 0V12H10.5a2.5 2.5 0 1 0 0-5H8.75V4.3A1.5 1.5 0 0 0 8 1.5zM5.5 9.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm5 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" },
	{ id: "ext", label: "Extensions", active: false, path: "M8.5 1.5 12 5v2.5h2.5v5H12V15H8.5v-2.5H6V10h2.5V7.5H6V5l2.5-3.5zM4 7.5V5H1.5v5H4V15h3.5v-2.5H5.5V10H8V7.5H4z" },
];
---

<aside
	class="hidden w-12 shrink-0 flex-col items-center border-r border-mk-border bg-mk-chrome py-2 md:flex"
	aria-label="Activity Bar"
>
	{
		icons.map((icon) => (
			<div
				class:list={[
					"mb-1 flex h-12 w-12 items-center justify-center border-l-2",
					icon.active
						? "border-mk-fg text-mk-fg"
						: "border-transparent text-mk-comment",
				]}
				title={icon.label}
				aria-hidden={!icon.active}
			>
				<svg class="h-6 w-6" viewBox="0 0 16 16" fill="currentColor">
					<path d={icon.path}></path>
				</svg>
			</div>
		))
	}
	<div class="mt-auto flex h-12 w-12 items-center justify-center text-mk-comment" title="Account" aria-hidden="true">
		<svg class="h-6 w-6" viewBox="0 0 16 16" fill="currentColor">
			<path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm0 1.5c-2.7 0-5 1.4-5 3.25V14h10v-1.25C13 10.9 10.7 9.5 8 9.5z"></path>
		</svg>
	</div>
</aside>
