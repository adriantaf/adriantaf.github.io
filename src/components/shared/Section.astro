---
interface Props {
	id: string;
	fileName: string;
	className?: string;
}

const { id, fileName, className = "" } = Astro.props as Props;
---

<section id={id} class={`border-b border-mk-border px-4 py-10 md:px-8 md:py-14 ${className}`}>
	<div class="mb-6 flex items-center gap-2 text-[12px] text-mk-comment">
		<span class="text-mk-param">portfolio</span>
		<span>&gt;</span>
		<span class="text-mk-fg">{fileName}</span>
	</div>
	<slot />
</section>
