---
interface Props {
	id: string;
	title: string;
	subtitle?: string;
	className?: string;
}

const { id, title, subtitle, className = "" } = Astro.props as Props;
---

<section id={id} class={`mx-auto w-full max-w-content px-5 py-20 md:px-6 md:py-28 ${className}`}>
	<div class="reveal mb-10 md:mb-14">
		<h2 class="text-[28px] font-semibold tracking-tight text-ink md:text-[40px] md:leading-tight">
			{title}
		</h2>
		{
			subtitle && (
				<p class="mt-3 max-w-xl text-[17px] leading-relaxed text-ink-muted md:text-[19px]">
					{subtitle}
				</p>
			)
		}
	</div>
	<slot />
</section>
