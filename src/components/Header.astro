---
---

<header
	id="site-header"
	class="sticky top-0 z-40 border-b-2 border-crt-bezel bg-crt/90 transition-shadow duration-200"
>
	<div class="mx-auto flex h-14 max-w-content items-center justify-between gap-3 px-4 md:px-6">
		<a href="#hero" class="font-pixel text-[10px] leading-none text-cyan md:text-[11px]">
			ATM ARCADE
		</a>

		<nav class="hidden items-center gap-5 md:flex" aria-label="Principal">
			<a class="nav-link" href="#work">STAGES</a>
			<a class="nav-link" href="#about">PROFILE</a>
			<a class="nav-link" href="#stack">POWER-UPS</a>
			<a href="mailto:atafoya863@gmail.com" class="arcade-btn arcade-btn-primary !py-2 !text-[8px]">
				CONTACTO
			</a>
		</nav>

		<button
			id="btn-menu"
			type="button"
			class="inline-flex h-9 w-9 items-center justify-center border-2 border-cyan text-cyan md:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Abrir menú"
		>
			<span class="sr-only">Menú</span>
			<svg id="icon-menu" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="square"></path>
			</svg>
			<svg id="icon-close" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M6 6l12 12M18 6L6 18" stroke-linecap="square"></path>
			</svg>
		</button>
	</div>

	<nav
		id="mobile-nav"
		class="hidden border-t-2 border-crt-bezel bg-crt-panel px-4 py-4 md:hidden"
		aria-label="Móvil"
	>
		<ul class="flex flex-col gap-1 font-pixel text-[9px] leading-relaxed">
			<li><a class="mobile-link" href="#work">STAGES</a></li>
			<li><a class="mobile-link" href="#about">PROFILE</a></li>
			<li><a class="mobile-link" href="#stack">POWER-UPS</a></li>
			<li>
				<a
					class="arcade-btn arcade-btn-primary mt-3 !text-[8px]"
					href="mailto:atafoya863@gmail.com"
				>
					CONTACTO
				</a>
			</li>
		</ul>
	</nav>
</header>

<style>
	.nav-link {
		font-family: var(--font-pixel);
		font-size: 8px;
		color: #8b9bb8;
		letter-spacing: 0.04em;
		transition: color 0.15s ease;
	}
	.nav-link:hover {
		color: #00e5ff;
	}
	.mobile-link {
		display: block;
		padding: 0.7rem 0;
		color: #e8f0ff;
	}
	.mobile-link:hover {
		color: #00e5ff;
	}
	#site-header.is-scrolled {
		box-shadow: 0 0 0 1px rgba(0, 229, 255, 0.15);
	}
</style>

<script>
	const header = document.getElementById("site-header");
	const btn = document.getElementById("btn-menu");
	const mobileNav = document.getElementById("mobile-nav");
	const iconMenu = document.getElementById("icon-menu");
	const iconClose = document.getElementById("icon-close");

	function setScrolled() {
		header?.classList.toggle("is-scrolled", window.scrollY > 8);
	}

	function setMenuOpen(open: boolean) {
		mobileNav?.classList.toggle("hidden", !open);
		iconMenu?.classList.toggle("hidden", open);
		iconClose?.classList.toggle("hidden", !open);
		btn?.setAttribute("aria-expanded", String(open));
		btn?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
	}

	window.addEventListener("scroll", setScrolled, { passive: true });
	setScrolled();

	btn?.addEventListener("click", () => {
		const open = btn.getAttribute("aria-expanded") !== "true";
		setMenuOpen(open);
	});

	mobileNav?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => setMenuOpen(false));
	});
</script>
